# Exchange selector — comma-separated list; run one or both simultaneously
# Examples: ACTIVE_EXCHANGES=extended
#           ACTIVE_EXCHANGES=hyperliquid
#           ACTIVE_EXCHANGES=extended,hyperliquid
# A JSON list works too: ACTIVE_EXCHANGES=["extended","hyperliquid"]
# If one exchange fails to connect, the others keep running; the error is sent
# to Telegram and the connection is retried automatically (30 s up to 10 min).
ACTIVE_EXCHANGES=extended

# Extended Exchange — authentication
# All five values are generated together when creating API keys in the Extended Exchange UI.
# NOTE: EXTENDED_PRIVATE_KEY and EXTENDED_PUBLIC_KEY are passed to the SDK but
# are never used for signing — this is a read-only monitoring system.
EXTENDED_API_KEY=sk-your-api-key
EXTENDED_PUBLIC_KEY=0x...your-stark-public-key
EXTENDED_PRIVATE_KEY=0x...your-stark-private-key
EXTENDED_VAULT=your-vault-number
EXTENDED_CLIENT_ID=your-client-id
EXTENDED_NETWORK=mainnet

# Hyperliquid — required only when ACTIVE_EXCHANGES contains hyperliquid
# No private key needed — read-only monitoring uses only the public wallet address.
# Use the MAIN account address (shown top right on hyperliquid.xyz), NOT an API
# (agent) wallet — an API wallet has no positions or orders of its own.
# checkDEX detects an API wallet at startup and reports the main account address
# in the log and in Telegram.
HYPERLIQUID_WALLET_ADDRESS=0x...your-wallet-address
HYPERLIQUID_TESTNET=false

# Telegram
TELEGRAM_BOT_TOKEN=0000000000:your-bot-token
TELEGRAM_CHAT_ID=-100your-chat-id
# Answer the /positions command sent in TELEGRAM_CHAT_ID (long polling, no open port needed).
# Set to false if another program reads updates of this bot token (Telegram returns 409 Conflict).
ENABLE_TELEGRAM_COMMANDS=true

# Polling intervals (seconds)
POLL_INTERVAL_ORDERS_SECONDS=60
POLL_INTERVAL_POSITIONS_SECONDS=60
POLL_INTERVAL_HISTORY_SECONDS=60

# Persistence
STATE_DB_PATH=/data/state.db
NOTIFICATION_DEDUP_TTL_DAYS=30

# Notifications — set to false to disable individual event types
ENABLE_ORDER_OPENED=true
ENABLE_ORDER_UPDATED=true
ENABLE_ORDER_FILLED=true
ENABLE_POSITION_OPENED=true
ENABLE_POSITION_UPDATED=true
ENABLE_POSITION_CLOSED=true
ENABLE_STARTUP_NOTIFICATION=true
ENABLE_DAILY_SUMMARY=true
DAILY_SUMMARY_TIME=08:00

# Unrealized PnL alert threshold in USDC (optional — leave empty to disable)
UNREALIZED_PNL_THRESHOLD_USDC=

# Logging — json (default, recommended for Docker) or text (for local dev)
LOG_LEVEL=INFO
LOG_FORMAT=json
